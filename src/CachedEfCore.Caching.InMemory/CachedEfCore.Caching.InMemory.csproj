<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Configurations>Debug;Release;TestRelease;TestDebug</Configurations>
	</PropertyGroup>

	<PropertyGroup>
		<RepositoryUrl>https://github.com/henriquewr/CachedEfCore</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<Title>CachedEfCore.Caching.InMemory</Title>
		<Authors>henriquewr</Authors>
		<PackageProjectUrl>https://www.nuget.org/packages/CachedEfCore.Caching.InMemory</PackageProjectUrl>
		<Description>InMemory store for CachedEfCore</Description>
		<EnforceCodeStyleInBuild>True</EnforceCodeStyleInBuild>
		<AnalysisLevel>latest-recommended</AnalysisLevel>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\CachedEfCore\CachedEfCore.csproj" />
	</ItemGroup>

	<PropertyGroup Condition="'$(Configuration)'=='TestDebug'">
		<DefineConstants>$(DefineConstants);TEST_BUILD</DefineConstants>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)'=='TestRelease'">
		<DefineConstants>$(DefineConstants);TEST_BUILD</DefineConstants>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='TestRelease|AnyCPU'">
		<Optimize>True</Optimize>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="CachedEfCore.Caching.InMemory.Tests" />
	</ItemGroup>
	
</Project>
