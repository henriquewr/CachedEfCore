<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Configurations>Debug;Release;TestRelease;TestDebug</Configurations>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\CachedEfCore\CachedEfCore.csproj" />
	</ItemGroup>

	<PropertyGroup Condition="'$(Configuration)'=='TestDebug'">
		<DefineConstants>$(DefineConstants);TEST_BUILD</DefineConstants>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)'=='TestRelease'">
		<DefineConstants>$(DefineConstants);TEST_BUILD</DefineConstants>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='TestRelease|AnyCPU'">
		<Optimize>True</Optimize>
	</PropertyGroup>
	
</Project>
