<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<PropertyGroup>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<Title>CachedEfCore.Caching.FusionCache</Title>
		<PackageProjectUrl>https://www.nuget.org/packages/CachedEfCore.Caching.FusionCache</PackageProjectUrl>
		<Description>FusionCache store for CachedEfCore</Description>
		<EnforceCodeStyleInBuild>True</EnforceCodeStyleInBuild>
		<AnalysisLevel>latest-recommended</AnalysisLevel>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\CachedEfCore\CachedEfCore.csproj" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="CachedEfCore.Caching.FusionCache.Tests" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="ZiggyCreatures.FusionCache" Version="2.8.0" />
	</ItemGroup>

</Project>
