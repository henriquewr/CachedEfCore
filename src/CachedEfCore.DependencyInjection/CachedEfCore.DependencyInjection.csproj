<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>
	
	<PropertyGroup>
		<RepositoryUrl>https://github.com/henriquewr/CachedEfCore</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<Title>CachedEfCore.DependencyInjection</Title>
		<Authors>henriquewr</Authors>
		<PackageProjectUrl>https://www.nuget.org/packages/CachedEfCore.DependencyInjection</PackageProjectUrl>
		<Description>Dependency injection extension for CachedEfCore</Description>
		<EnforceCodeStyleInBuild>True</EnforceCodeStyleInBuild>
		<AnalysisLevel>latest-recommended</AnalysisLevel>
	</PropertyGroup>
	
	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.1" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\CachedEfCore\CachedEfCore.csproj" />
	</ItemGroup>

</Project>
